-- Скрипт-дампер для Xeno с GUI-статусом (Project Delta)
-- Запустите в игре. Окно покажет процесс и результат.

-- Создаём GUI
local player = game:GetService("Players").LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "DataDumperGUI"
gui.ResetOnSpawn = false
-- Пытаемся поместить в CoreGui (чтобы не удалялось), иначе в PlayerGui
pcall(function() gui.Parent = game:GetService("CoreGui") end)
if not gui.Parent then
    gui.Parent = player:WaitForChild("PlayerGui")
end

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 120)
frame.Position = UDim2.new(0.5, -150, 0.5, -60)
frame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
frame.BackgroundTransparency = 0.3
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 25)
title.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)
title.Text = "Сбор данных игры"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.SourceSansBold
title.TextSize = 18
title.Parent = frame

local icon = Instance.new("TextLabel")
icon.Size = UDim2.new(0, 40, 0, 40)
icon.Position = UDim2.new(0, 10, 0, 35)
icon.BackgroundTransparency = 1
icon.Text = "⏳"  -- иконка ожидания
icon.TextColor3 = Color3.new(1, 1, 0)
icon.Font = Enum.Font.SourceSansBold
icon.TextSize = 30
icon.Parent = frame

local message = Instance.new("TextLabel")
message.Size = UDim2.new(0, 220, 0, 40)
message.Position = UDim2.new(0, 60, 0, 35)
message.BackgroundTransparency = 1
message.Text = "Идёт сбор данных..."
message.TextColor3 = Color3.new(1, 1, 1)
message.TextXAlignment = Enum.TextXAlignment.Left
message.Font = Enum.Font.SourceSans
message.TextSize = 16
message.Parent = frame

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 60, 0, 25)
closeBtn.Position = UDim2.new(1, -70, 1, -30)
closeBtn.BackgroundColor3 = Color3.new(0.6, 0.3, 0.3)
closeBtn.Text = "Закрыть"
closeBtn.TextColor3 = Color3.new(1, 1, 1)
closeBtn.Font = Enum.Font.SourceSans
closeBtn.TextSize = 16
closeBtn.Parent = frame
closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

-- Функция обновления статуса
local function setStatus(success, msg)
    if success then
        icon.Text = "✅"
        icon.TextColor3 = Color3.new(0, 1, 0)
        message.Text = msg or "Успешно! Данные сохранены."
    else
        icon.Text = "❌"
        icon.TextColor3 = Color3.new(1, 0, 0)
        message.Text = msg or "Ошибка! Подробности в консоли."
    end
end

-- Основной сбор данных (с защитой от ошибок)
local success, err = pcall(function()
    -- сам дамп (как в предыдущем скрипте)
    local dump = {"===== ДАМП PROJECT DELTA ДЛЯ XENO ====="}
    local function addLine(l) table.insert(dump, l) end
    local function addSection(title) addLine("\n----- " .. title .. " -----") end

    addSection("ОБЩАЯ ИНФОРМАЦИЯ")
    addLine("Игрок: " .. tostring(player))
    addLine("GameId: " .. game.GameId)
    addLine("PlaceId: " .. game.PlaceId)

    addSection("REMOTE EVENTS")
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            addLine(obj:GetFullName())
        end
    end

    addSection("СКРИПТЫ")
    local scriptsFound = 0
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            scriptsFound = scriptsFound + 1
            local name = obj:GetFullName()
            local src = ""
            pcall(function()
                if getsrc then src = getsrc(obj)
                elseif obj.Source and obj.Source ~= "" then src = obj.Source
                elseif getscriptbytecode then
                    local bc = getscriptbytecode(obj)
                    if bc then src = "--- БАЙТКОД ---\n" .. tostring(bc) end
                end
            end)
            if src == "" then src = "[КОД НЕДОСТУПЕН]" end
            addLine(name .. "\n" .. src)
        end
    end
    addLine("Всего скриптов найдено: " .. scriptsFound)

    local output = table.concat(dump, "\n")
    local ok, err = pcall(writefile, "ProjectDelta_Xeno_Dump.txt", output)
    if ok then
        setStatus(true, "Файл сохранён: ProjectDelta_Xeno_Dump.txt")
    else
        -- пробуем буфер обмена
        pcall(setclipboard, output)
        setStatus(true, "Данные скопированы в буфер (вставьте в .txt)")
    end
end)

if not success then
    setStatus(false, "Ошибка: " .. tostring(err))
end

-- Автоматическое скрытие через 30 секунд (опционально)
delay(30, function()
    if gui and gui.Parent then
        gui:Destroy()
    end
end)
