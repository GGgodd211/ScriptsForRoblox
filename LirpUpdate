-- Основная логика загрузчика
local function loader()
    local gui = createLoadingGUI()
    if not authorize(Key) then return end

    gui:setStatus("Загрузка модулей...")
    gui:setProgress(30)
    gui:addLog("Инициализация API")

    -- Функции работы с конфигами (улучшенные)
    local function Load(Variable, Filename)
        if type(Filename) ~= "string" then return nil end
        if type(isfile) ~= "function" then return nil end
        local ok, exists = pcall(isfile, Filename)
        if not ok or not exists then return nil end
        if Variable == "UDim2" then
            local Data = readfile(Filename)
            local XScale, XOffset, YScale, YOffset = string.match(Data, "([%d%.%-]+),([%d%.%-]+),([%d%.%-]+),([%d%.%-]+)")
            if XScale and YScale then
                return UDim2.new(tonumber(XScale), tonumber(XOffset), tonumber(YScale), tonumber(YOffset))
            else
                return nil
            end
        else
            return readfile(Filename)
        end
    end

    local function Save(Variable, Filename)
        if type(Filename) ~= "string" then return end
        if typeof(Variable) == "UDim2" then
            local Data = Variable.X.Scale .. "," .. Variable.X.Offset .. "," .. Variable.Y.Scale .. "," .. Variable.Y.Offset
            if not Filename:match("%.txt$") then Filename = Filename .. ".txt" end
            writefile(Filename, Data)
        else
            writefile(Filename, tostring(Variable))
        end
    end

    -- Обработка конфигов (с дополнительной очисткой)
    local Config = Load("Text", "AutoLoadConfig")
    local Path = Config and ("ProjectDelta" .. tostring(Config) .. ".txt") or nil
    if Path then
        gui:addLog("Обнаружен конфиг: " .. Path)
        local ConfigText = Load("Text", Path)
        if ConfigText then
            gui:addLog("Очистка конфига от следов")
            ConfigText = ConfigText:gsub('"Instant Hit %- Requires Silent"', '"Regular"')
            ConfigText = ConfigText:gsub(',%s*"Key"%s*:%s*".-"%s*', '')
            ConfigText = ConfigText:gsub('"Key"%s*:%s*".-"%s*,%s*', '')
            ConfigText = ConfigText:gsub('"Key"%s*:%s*".-"%s*', '')
            Save(ConfigText, Path)
            gui:addLog("✓ Конфиг обработан")
        end
        gui:setProgress(50)
    else
        gui:addLog("Конфиг автозагрузки не найден")
    end

    -- Удаление временных файлов
    if type(delfile) == "function" then
        pcall(delfile, "AutoLoadConfig")
        pcall(delfile, "AutoLoadConfig.txt")
        pcall(delfile, "LastLoadedConfig")
        pcall(delfile, "LastLoadedConfig.txt")
        gui:addLog("Временные файлы удалены")
    end
    gui:setProgress(70)

    -- Загрузка основного чита (здесь может быть ваш код)
    gui:setStatus("Загрузка основного модуля...")
    gui:addLog("Подключение к серверу")
    wait(1)
    gui:setProgress(90)
    gui:addLog("✓ Основной модуль загружен")

    -- Активация чита
    gui:setStatus("Активация...")
    gui:addLog("Внедрение в игру")
    wait(0.5)
    gui:setProgress(100)
    gui:addLog("✓ Чит успешно активирован")
    gui:setStatus("Готово!")

    -- Убираем GUI через 3 секунды
    wait(3)
    pcall(function() gui.gui:Destroy() end)
end

