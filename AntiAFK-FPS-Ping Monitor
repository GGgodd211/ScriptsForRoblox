        Color = Color3.fromRGB(70, 130, 255),
        Thickness = 1.2,
        Transparency = 0.45,
        Parent = MainBar
    })

    -- Inner background gradient simulation
    local inner = Create("Frame", {
        Size = UDim2.new(1, -2, 1, -2),
        Position = UDim2.new(0, 1, 0, 1),
        BackgroundColor3 = Color3.fromRGB(18, 18, 24),
        BorderSizePixel = 0,
        Parent = MainBar
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 9), Parent = inner})

    -- Left accent line
    Create("Frame", {
        Size = UDim2.new(0, 3, 0.62, 0),
