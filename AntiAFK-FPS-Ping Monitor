        BackgroundColor3 = Color3.fromRGB(80, 150, 255),
        BorderSizePixel = 0,
        Parent = MainBar
    })

    -- Status dot
    StatusDot = Create("Frame", {
        Size = UDim2.new(0, 7, 0, 7),
        Position = UDim2.new(0, 18, 0.5, -3.5),
        BackgroundColor3 = Color3.fromRGB(70, 255, 130),
        BorderSizePixel = 0,
        Parent = MainBar
    })
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = StatusDot})

    -- Status text
    StatusText = Create("TextLabel", {
        Size = UDim2.new(0, 48, 1, 0),
        Position = UDim2.new(0, 30, 0, 0),
        BackgroundTransparency = 1,
        Text = "AFK",
        TextColor3 = Color3.fromRGB(70, 255, 130),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = MainBar
    })

    -- Divider 1
    Create("Frame", {
        Size = UDim2.new(0, 1, 0.45, 0),
        Position = UDim2.new(0, 78, 0.275, 0),
        BackgroundColor3 = Color3.fromRGB(50, 50, 65),
        BorderSizePixel = 0,
        Parent = MainBar
    })

    -- FPS
    FPSText = Create("TextLabel", {
        Size = UDim2.new(0, 58, 1, 0),
        Position = UDim2.new(0, 86, 0, 0),
        BackgroundTransparency = 1,
        Text = "FPS 0",
        TextColor3 = Color3.fromRGB(160, 200, 255),
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = MainBar
    })

    -- Divider 2
    Create("Frame", {
        Size = UDim2.new(0, 1, 0.45, 0),
        Position = UDim2.new(0, 148, 0.275, 0),
        BackgroundColor3 = Color3.fromRGB(50, 50, 65),
        BorderSizePixel = 0,
        Parent = MainBar
    })

    -- Ping
    PingText = Create("TextLabel", {
        Size = UDim2.new(0, 62, 1, 0),
        Position = UDim2.new(0, 156, 0, 0),
        BackgroundTransparency = 1,
        Text = "0 ms",
        TextColor3 = Color3.fromRGB(255, 210, 120),
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = MainBar
    })

    -- Divider 3
    Create("Frame", {
        Size = UDim2.new(0, 1, 0.45, 0),
        Position = UDim2.new(0, 222, 0.275, 0),
        BackgroundColor3 = Color3.fromRGB(50, 50, 65),
        BorderSizePixel = 0,
        Parent = MainBar
    })

    -- Session time
    TimeText = Create("TextLabel", {
        Size = UDim2.new(0, 52, 1, 0),
        Position = UDim2.new(0, 230, 0, 0),
        BackgroundTransparency = 1,
        Text = "00:00",
        TextColor3 = Color3.fromRGB(190, 170, 255),
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = MainBar
    })

    -- Toggle button (right side)
    ToggleBtn = Create("TextButton", {
        Size = UDim2.new(0, 42, 0, 20),
        Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(35, 95, 65),
        Text = "ON",
        TextColor3 = Color3.fromRGB(220, 255, 230),
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        Parent = MainBar
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ToggleBtn})

    -- Hover effects
    ToggleBtn.MouseEnter:Connect(function()
        Tween(ToggleBtn, {BackgroundColor3 = Config.AntiAFK and Color3.fromRGB(45, 120, 80) or Color3.fromRGB(140, 55, 55)})
    end)
    ToggleBtn.MouseLeave:Connect(function()
        Tween(ToggleBtn, {BackgroundColor3 = Config.AntiAFK and Color3.fromRGB(35, 95, 65) or Color3.fromRGB(110, 45, 45)})
    end)

    ToggleBtn.MouseButton1Click:Connect(function()
        Config.AntiAFK = not Config.AntiAFK
        ToggleBtn.Text = Config.AntiAFK and "ON" or "OFF"
        Tween(ToggleBtn, {
            BackgroundColor3 = Config.AntiAFK and Color3.fromRGB(35, 95, 65) or Color3.fromRGB(110, 45, 45)
        })
        Tween(StatusDot, {
            BackgroundColor3 = Config.AntiAFK and Color3.fromRGB(70, 255, 130) or Color3.fromRGB(255, 80, 80)
        })
        StatusText.TextColor3 = Config.AntiAFK and Color3.fromRGB(70, 255, 130) or Color3.fromRGB(255, 90, 90)
        StatusText.Text = Config.AntiAFK and "AFK" or "OFF"
    end)

    -- Dragging
    local dragging, dragStart, startPos
    MainBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainBar.Position
            Tween(stroke, {Transparency = 0.15, Color = Color3.fromRGB(100, 170, 255)})
        end
    end)
    MainBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            Tween(stroke, {Transparency = 0.45, Color = Color3.fromRGB(70, 130, 255)})
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            MainBar.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Hotkey
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Config.ToggleKey then
            Config.GUIVisible = not Config.GUIVisible
            ScreenGui.Enabled = Config.GUIVisible
        end
    end)

    -- Entrance animation
    MainBar.Size = UDim2.new(0, 0, 0, 32)
    MainBar.BackgroundTransparency = 1
    Tween(MainBar, {Size = UDim2.new(0, 340, 0, 32), BackgroundTransparency = 0}, 0.45, Enum.EasingStyle.Quint)
end

local function UpdateGUI()
    task.spawn(function()
        while State.IsRunning do
            if FPSText then
                FPSText.Text = "FPS " .. State.FPS
                FPSText.TextColor3 = State.FPS >= 60 and Color3.fromRGB(100, 220, 140)
                    or State.FPS >= 30 and Color3.fromRGB(255, 200, 100)
                    or Color3.fromRGB(255, 90, 90)
            end
            if PingText then
                PingText.Text = State.Ping .. " ms"
                PingText.TextColor3 = State.Ping <= 70 and Color3.fromRGB(100, 220, 140)
                    or State.Ping <= 140 and Color3.fromRGB(255, 200, 100)
                    or Color3.fromRGB(255, 90, 90)
            end
            if TimeText then
                local t = tick() - State.SessionStart
                TimeText.Text = string.format("%02d:%02d", math.floor(t / 60), math.floor(t % 60))
            end
            task.wait(0.2)
        end
    end)
end

-- ====================== INIT ======================
local function Init()
    CreateGUI()
    SetupAntiAFK()
    UpdateStats()
    ApplyFPSBoost()
    SetupAutoRejoin()
    UpdateGUI()

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Ultimate AntiAFK",
            Text = "Compkiller UI loaded | RightShift",
            Duration = 4
        })
    end)
end

Init()

Players.PlayerRemoving:Connect(function(p)
    if p == LocalPlayer then
        State.IsRunning = false
        for _, c in pairs(State.Connections) do
            pcall(function() c:Disconnect() end)
        end
    end
end)
