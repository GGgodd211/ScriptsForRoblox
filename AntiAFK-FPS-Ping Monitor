--[[
    Ultimate AntiAFK + FPS + Ping Monitor
    Roblox 2025-2026 | Compkiller-level GUI (ultra compact one-line)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Stats = game:GetService("Stats")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")
local VirtualUser = game:GetService("VirtualUser")
local CoreGui = game:GetService("CoreGui")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ====================== CONFIG ======================
local Config = {
    AntiAFK = true,
    FPSBoost = true,
    AutoRejoin = true,
    LowGraphics = true,
    AntiAFKMethod = "Idled+Virtual",
    ToggleKey = Enum.KeyCode.RightShift,
    GUIVisible = true
}

-- ====================== STATE ======================
local State = {
    FPS = 0,
    Ping = 0,
    SessionStart = tick(),
    IsRunning = true,
    Connections = {}
}

-- ====================== UTILS ======================
local function Create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    return obj
end

local function Tween(obj, props, duration, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(duration or 0.25, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

-- ====================== ANTI-AFK CORE ======================
local function SetupAntiAFK()
    table.insert(State.Connections, LocalPlayer.Idled:Connect(function()
        if not Config.AntiAFK then return end
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end))

    task.spawn(function()
        while State.IsRunning do
            if Config.AntiAFK and Config.AntiAFKMethod:find("Virtual") then
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new(math.random(10, 80), math.random(10, 80)))
                end)
            end
            if Config.AntiAFK and Config.AntiAFKMethod:find("Camera") then
                pcall(function()
                    Camera.CFrame = Camera.CFrame * CFrame.Angles(0, math.rad(0.04), 0)
                end)
            end
            task.wait(math.random(14, 28))
        end
    end)
end

-- ====================== STATS ======================
local function UpdateStats()
    local last = tick()
    local frames = 0
    table.insert(State.Connections, RunService.RenderStepped:Connect(function()
        frames += 1
        if tick() - last >= 1 then
            State.FPS = frames
            frames = 0
            last = tick()
        end
    end))

    task.spawn(function()
        while State.IsRunning do
            local pingItem = Stats.Network.ServerStatsItem["Data Ping"]
            State.Ping = pingItem and math.floor(pingItem:GetValue()) or 0
            task.wait(0.4)
        end
    end)
end

-- ====================== FPS BOOST ======================
local function ApplyFPSBoost()
    if not Config.FPSBoost then return end
    if Config.LowGraphics then
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            for _, v in pairs(Lighting:GetChildren()) do
                if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("ColorCorrectionEffect") then
                    v.Enabled = false
                end
            end
            workspace.Terrain.WaterWaveSize = 0
            workspace.Terrain.WaterWaveSpeed = 0
            workspace.Terrain.WaterReflectance = 0
            workspace.Terrain.WaterTransparency = 1
        end)
    end
end

-- ====================== AUTO REJOIN ======================
local function SetupAutoRejoin()
    if not Config.AutoRejoin then return end
    table.insert(State.Connections, GuiService.ErrorMessageChanged:Connect(function()
        if GuiService:GetErrorMessage() ~= "" then
            task.wait(1.4)
            pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
        end
    end))
end

-- ====================== COMPKILLER-STYLE ONE-LINE GUI ======================
local ScreenGui, MainBar, StatusDot, StatusText, FPSText, PingText, TimeText, ToggleBtn

