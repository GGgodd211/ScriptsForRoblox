-- Krnl Dumper для Project Delta
-- Запустите в игре, через несколько секунд в папке krnl\workspace появится файл с данными

local dump = {
    "===== ДАМП ИГРЫ PROJECT DELTA =====",
    "Время: " .. os.date("%Y-%m-%d %H:%M:%S"),
    ""
}

local function addSection(title, tbl)
    table.insert(dump, ("\n"):rep(2) .. "----- " .. title .. " -----")
    for _, v in ipairs(tbl) do
        table.insert(dump, v)
    end
end

-- 1. Собираем все скрипты
local scripts = {}
for _, obj in ipairs(game:GetDescendants()) do
    if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
        local src = ""
        -- Пробуем получить код
        pcall(function() src = getsrc(obj) end)
        if src == nil or src == "" then
            pcall(function() src = obj.Source end)
        end
        if src == nil or src == "" then
            src = "[НЕДОСТУПНО]"
        end
        table.insert(scripts, string.format("%s\n%s", obj:GetFullName(), src))
    end
end
addSection("СКРИПТЫ", scripts)

-- 2. Собираем RemoteEvent'ы (важно для анализа античита)
local remotes = {}
for _, obj in ipairs(game:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        table.insert(remotes, obj:GetFullName())
    end
end
addSection("REMOTE EVENTS", remotes)

-- 3. Информация об игроке и окружении
local envInfo = {
    "LocalPlayer: " .. tostring(game:GetService("Players").LocalPlayer),
    "GameId: " .. game.GameId,
    "PlaceId: " .. game.PlaceId,
}
addSection("ОКРУЖЕНИЕ", envInfo)

-- Сохраняем в файл
local data = table.concat(dump, "\n")
local success, err = pcall(function()
    writefile("ProjectDelta_FullDump.txt", data)
end)

if success then
    print("[[[ ДАМП СОХРАНЁН ]]]")
    print("Файл: krnl\\workspace\\ProjectDelta_FullDump.txt")
    print("Скопируй его и отправь мне. Если файл пустой — проверь права доступа.")
else
    print("[[[ ОШИБКА ЗАПИСИ ]]]")
    print("Пробую скопировать в буфер обмена...")
    pcall(function() setclipboard(data) end)
    print("Данные скопированы. Если текст огромный, вставь его в блокнот частями.")
end

print("\nГотово. Жду файл от тебя.")
